# Frontend (Vite) — visibles en el navegador, van en Vercel como "Environment Variables"
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# Backend (funciones serverless en /api) — SECRETAS, nunca en el frontend
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta

# Nota: ya NO hay una llave global de Culqi — cada consultorio tiene la suya
# propia, guardada en la columna culqi_secret_key de la tabla `consultorios`.
